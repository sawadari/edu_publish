{
  "name": "edu-publish-slides",
  "version": "1.0.0",
  "description": "Marp slide creation with Rector style for technical presentations",
  "main": "index.js",
  "scripts": {
    "marp:build": "marp slides/presentations/sample.md -o slides/output/sample.html --html --allow-local-files",
    "marp:build:all": "marp slides/presentations/*.md --html --allow-local-files",
    "marp:watch": "marp -w slides/presentations/*.md --html --allow-local-files",
    "marp:server": "marp -s slides/presentations/ --html --allow-local-files"
  },
  "keywords": [
    "marp",
    "presentations",
    "slides",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.0",
    "tailwindcss": "^3.4.0"
  }
}
